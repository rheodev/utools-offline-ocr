{
  "name": "离线文字识别",
  "source": "src/style.css",
  "mode": "operate",
  "verification": "source-only; visual browser verification pending",
  "colors": {
    "primary": "#17644d",
    "background": "#f5f6f3",
    "surface": "#ffffff",
    "text": "#28342f",
    "muted": "#65726b",
    "border": "#dde3dc"
  },
  "typography": {
    "title": { "fontSize": "19px", "fontWeight": 650, "lineHeight": 1.4 },
    "body": { "fontSize": "14px", "lineHeight": 1.9 }
  },
  "rounded": { "button": "7px", "workspace": "10px" },
  "spacing": { "small": "8px", "medium": "16px", "large": "24px" },
  "extensions": {
    "responsive": { "stackedAt": "680px" },
    "motion": { "respectsReducedMotion": true },
    "theme": "system light/dark"
  }
}
