{
  "main": "index.html",
  "logo": "logo.png",
  "preload": "preload.js",
  "pluginSetting": { "single": true, "height": 600 },
  "features": [
    {
      "code": "ocr",
      "description": "离线识别图片中的中英文 / Offline Chinese & English OCR",
      "platform": ["win32", "darwin"],
      "cmds": [
        "离线文字识别",
        "离线OCR",
        "Offline OCR",
        { "type": "img", "label": "离线识别图片文字 / Offline image OCR" },
        { "type": "files", "label": "离线识别图片文件 / Offline image file OCR", "fileType": "file", "extensions": ["png", "jpg", "jpeg", "webp", "bmp"], "minLength": 1, "maxLength": 1 }
      ]
    },
    {
      "code": "capture",
      "description": "框选屏幕并识别文字 / Capture a region for offline OCR",
      "platform": ["win32", "darwin"],
      "cmds": ["离线截图识别", "Capture OCR"]
    }
  ]
}
